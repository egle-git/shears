The instructions for running the W+jets analysis code on Bonzai (also possibly on Baobab) data and MC ntuples produced at 13 TeV.
Kadir Ocalan (29.10.2015)
updated by K. Ocalan on 06.03.2016)

-- For now use CMSSW_5_3_11, planned migration to CMSSW 76X 

cmsrel CMSSW_5_3_11  
cd CMSSW_5_3_11/src
cmsenv 

-- Clone shears from the gitlab (can be found here https://gitlab.cern.ch/shears/shears/tree/master)
git clone ssh://git@gitlab.cern.ch:7999/shears/shears.git

-- Go to the directory 
cd shears/WJets

-- Compile RooUnfold
cd RooUnfold
make clean
make
cd -

-- One can run on the skimmed ntuples called Bonzais. The paths to these Bonzais are specified in the txt files in the directory WJets/DataW_txt. You can add similar text files pointing to any bonzai if you want.
 
-- SKIP the following steps if you run on Bonzai: Another option is to run on 13 TeV Baobab data and MC 25ns samples that are merged from here /eos/cms/store/group/phys_smp/AnalysisFramework/Baobab/

mkdir DataW
mkdir ~/eos
eosmount ~/eos
ln -s  ~/eos/cms/store/user/ocalan/13TeV_25ns   DataW
--SKIP until here

-- Ready to run the code!!! Before running it, change doQCD to 0 (int doQCD=0) in WJets/runDYJets.cc.

-- Run the code under /WJets
root -b -q runDYJets.cc++  

-- For QCD Background go to WJets/runDYJets.cc change int doQCD = 1
root -b -q runDYJets.cc
# Change it 1-3 and run every time. 

-- Output root files are available in the directory HistoFiles.

-- Merge single top and DYJets root files:
root -b -q MergeTop_BVeto.cc++

-- Merge di-boson (WW, WZ, and ZZ) root files:
root -b -q MergeVV_BVeto.cc++

-- Merge QCD Background:
root -b -q runQCD_BVeto.cc++

-- Plotting:
root -b -q runTest_BVeto.cc++

--Congratulations! Output PDF files will be in the directory PNGFiles
