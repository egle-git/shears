#!/bin/bash

#Author: Dylan Rankin
#Description: Script to check (using brilcalc) whether triggers were prescaled after the first good lumisection of each run in a json file.

#Example: ./checkPrescales.sh 'HLT_Mu45_eta2p1_v* HLT_Mu50_v*' Cert_271036-276811_13TeV_PromptReco_Collisions16_JSON_NoL1T.txt
# ./checkPrescales_mod.sh 'HLT_Mu17_TrkIsoVVL_Mu8_TrkIsoVVL_DZ_v* HLT_Mu17_TrkIsoVVL_TkMu8_TrkIsoVVL_DZ_v*' mergedJSONFile_03_08_2017.tex &>prescale_output_DZ_1_03_20_2017.log &

if [ `echo ${PATH} | grep -c "bril"` -eq 0 ]; then
    export PATH=$HOME/.local/bin:/afs/cern.ch/cms/lumi/brilconda-1.1.7/bin:$PATH
fi

DEBUG=0

for run in $( sed 's/\([0-9]\+\)":/\n\1/g' $2 | sed 's/\(^[0-9]\+\).*$/\1/g' | sed '/^[0-9]/! d' ); do
    UNPRE=0
    if [ $DEBUG -eq 1 ]; then echo "run =  $run"; fi
    START=`eval "sed 's/.*${run}\": \[\[\([0-9]\+\),/@\1@/g' $2 | sed '/^@/! d' | cut -d'@' -f2"`
    if [ $DEBUG -eq 1 ]; then echo "Start = $START"; fi
    for trig in $( echo $1 ); do
	#echo "Evaluating brilcalc call"
	eval brilcalc trg --prescale --hltpath ${trig} -r ${run} -o test.csv
	if [ $DEBUG -eq 1 ]; then eval brilcalc trg --prescale --hltpath ${trig} -r ${run}; fi
	if [[ -f "test.csv" ]]
	then
	    while read -r line ; do
		if [ $DEBUG -eq 1 ]; then echo "line = $line"; fi
		if [ ${line:0:1} != "#" ]; then
		    #echo $line | cut -d',' -f2
		    lumiSection=$( echo "$line" |cut -d',' -f2 )
		    preScale=$( echo "$line" |cut -d',' -f4 )
		    #echo "lumiSection = ${lumiSection}"
		    #echo "preScale = ${preScale}"
		    if [ ${lumiSection} -ge ${START} ]; then
			#echo "line with lumi cut= ${line}"

			if [ ${preScale} -gt 1 ]; then
			    echo "PRESCALED   Run ${run}: ${trig}"
			    #grep -B1 -A1 "^.*,.*,.*,0" test.csv
			    UNPRE=1
			    break
			fi
		    fi
		fi
	    #done
	    done < "test.csv"
	fi
	if [ $UNPRE -eq 0 ]; then
	    echo "UNPRESCALED Run ${run}: ${trig}"
	fi
    done
done

rm test.csv
