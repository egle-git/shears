#!/bin/bash

if [  $# -lt 1 -o "$1" = -h -o "$1" = --help ]; then
   cat <<EOF
Usage: getlumi JSON_FILE [dataset]

Calculates processed integrated luminosity from a crab job lumi section report.

dataset: 2015 or 2016

EOF
fi

if [ "$1" = -r ]; then
    recorded_only=y
    shift
else
    recorded_only=n
fi

filter(){
    if [ "$recorded_only" = y ]; then
	tail -n 2 | head -n 1 | awk -F \| '{printf "%f\n", $7/1.e6}'
    else
	cat
    fi
}

dataset="$1"

#Normtag of 2015 data Updated on Mar. 31, 16
normtag=/afs/cern.ch/user/l/lumipro/public/normtag_file/moriond16_normtag.json

[ $dataset=2016 ] && normtag=/afs/cern.ch/user/l/lumipro/public/Normtags/normtag_DATACERT.json

#python /afs/cern.ch/user/m/marlow/public/lcr2/lcr2.py -i  "$1" | filter

export PATH=$HOME/.local/bin:/afs/cern.ch/cms/lumi/brilconda-1.0.3/bin:$PATH

#check if brilcalc 2.2.0 is already installed...
[ -x $HOME/.local/bin/brilcalc ] && ~/.local/bin/brilcalc --version | grep -q '^2\.2\.0$' 
#... if not, install it:
if [ $? != 0 ]; then
    pip uninstall brilws
    pip install --install-option="--prefix=$HOME/.local" brilws
fi

#brilcalc lumi -i "$1" -n 0.962 | filter
#before Dec. 6, 15:
#brilcalc lumi --normtag /afs/cern.ch/user/c/cmsbril/public/normtag_json/OfflineNormtagV1.json -i "$1"  | filter
#Updated on Dec. 6, 15 to normtag announced in https://hypernews.cern.ch/HyperNews/CMS/get/luminosity/544.html
#brilcalc lumi --normtag /afs/cern.ch/user/l/lumipro/public/normtag_file/OfflineNormtagV2.json -i "$1"  | filter
echo "Using normtag $normtag." 1>&2
brilcalc lumi --normtag  "$normtag" -i "$1"  --without-checkjson | filter


