def getDbConn():
    """Gets job management connection and cursor."""
    conn = sqlite3.connect('baobab_prod.sqlite3')
    conn.execute('PRAGMA foreign_keys')
    return (conn, conn.cursor())

def createDatabase():
    """Creates sqlite3 database used to manage the jobs submissions. Tables are created only if they do not already exists."""
    (conn, c) = getDbConn()
    conn.execute('''CREATE TABLE IF NOT EXISTS jobs (
dataset     TEXT,
batch_id    INTEGER,
datatype    TEXT,
ntuple_dir  TEXT,
ntuple_subdir TEXT,
submit_ts   INTEGER,
status      TEXT,
status_ts   INTEGER,
uniquerequestname TEXT,
requestname TEXT,
n_files     INTEGER,
lumi_file_md5sum TEXT,
PRIMARY KEY(dataset, batch_id)
)''')
    conn.execute('''CREATE TABLE IF NOT EXISTS runs (
dataset TEXT,
run INTEGER,
batch_id INTEGER,
PRIMARY KEY (dataset, run),
FOREIGN KEY (dataset, batch_id) REFERENCES jobs (dataset, batch_id))
''')
    conn.commit()
    conn.close()
