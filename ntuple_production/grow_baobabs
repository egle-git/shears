def isDatasetInDb(dataset):
    """Checks if a dataset is in the job management database"""
    conn, c = getDbConn()
    c.execute("SELECT dataset FROM jobs WHERE dataset='%s'" % dataset)
    return c.fetchone() is not None

def getBatchStatus(dataset, batch_id):
    """Retrieves from job management database the status of a job batch"""
    conn, c = getDbConn()
    c.execute("SELECT status FROM jobs WHERE dataset='%s' AND batch_id=%d" % (dataset, batch_id))
    r = c.fetchone()
    if r:
        return str(r[0])
    else:
        return None

def getDatatypeFromDb(dataset):
    """Retrieves the datatype (mc or data) from the job management database."""
    conn, c = getDbConn()
    c.execute("SELECT DISTINCT datatype FROM jobs")
    r = c.fetchall()
    if len(r) > 1:
        raise error.Runtime("Inconsistency found in job management database!")
    elif len(r) == 1:
        return r[0][0]
    else:
        return None

def lastBatchId(dataset):
    """Gets the latest batch id (maximum batch id value) for the processing of a dataset."""
    conn, c  = getDbConn()
    c.execute("SELECT MAX(batch_id) FROM runs WHERE dataset='%s'" % dataset)
    r = c.fetchone()
    if r:
        r = r[0]
    return r

def getRunsFromDb(dataset):
    """Retrieves the list of runs entered in job database for a dataset and the last batch id."""
    conn, c = getDbConn()
    c.execute("SELECT run FROM runs WHERE dataset='%s'" % dataset)
    r = c.fetchall()
    conn.close()
    if len(r) > 0:
        r = zip(*r)[0]
    return r

def checkRunToProcess(dataset):
    """Checks for new run to consider for a dataset. Applies to real data only."""
    available = dasRuns(dataset)
    known = getRunsFromDb(dataset)
    toprocess = sorted(tuple(set(available) - set(known)))
    if args.max_run_num:
        toprocess = [ x for x in toprocess if x < args.max_run_num]
    return toprocess

def insertBatch(dataset,ntuple_dir,ts):
    """"Checks if a dataset needs to be processed and if it does
inserts the job batch in the database. Return the batch_id or None."""
    datatype = getDatatypeFromDb(dataset)
    if datatype:
        newDataset = False
    else:
        newDataset = True
        res = dasQuery2("dataset dataset=%s" % dataset, "dataset.datatype");
        print res
        if len(res) == 0:
            sys.stderr.write("Dataset %s was not found in DAS. This dataset will be skipped.\n" % dataset);
            return None
        datatype = str(res[0])
        if datatype not in ["mc", "data"]:
            sys.stderr.write("Datatype ('%s') returned by DAS for the dataset %s is not supported. The dataset will be skipped.\n" % (res['datatype'], dataset)) 
            return None
    if newDataset:
        batch_id = 1
    if (not newDataset) and datatype == 'mc':
        #no top-up for MC
        return None
    if datatype == 'mc':
        runs = []
    else: #real data
        runs =  checkRunToProcess(dataset)
        if len(runs) > 0:
            if args.verbosity > 0:
                sys.stderr.write("Prepare job batch for dataset %s, runs %s\n" % (dataset, ",".join(map(str, runs))))
            batch_id = lastBatchId(dataset)
            if batch_id:
                batch_id = batch_id + 1
            else:
                batch_id = 1
        else:
            if args.verbosity > 0:
                sys.stderr.write("No new run for dataset %s.\n" % dataset)
            return None
    #endif datatype
    #endif newDataset
    #this point is reached when a job batch needs to be inserted.
    try:
        conn, c = getDbConn()
        conn.execute("INSERT INTO jobs VALUES('%s',%d,'%s','%s',%d, NULL, '%s', NULL, NULL, NULL, NULL, NULL)" % (dataset, batch_id, datatype, ntuple_dir, ts, 'to_submit'))
        conn.commit()
        conn.close()
    except sqlite3.IntegrityError:
        sys.stderr.write("Unexpected error when processing dataset %s. % dataset")
        return None
    return (batch_id, runs)

def updateDatasetRecord(dataset, batch_id, props):
    """Update the record of a dataset job batch in the job management database."""
    conn, c = getDbConn()
    sql = 'UPDATE jobs SET '
    sql += ",".join([ " %s='%s'" % (k,v) for (k,v) in props.items()])
    sql += " WHERE dataset='%s' AND batch_id=%d" % (dataset, batch_id)
    nrows = conn.execute(sql).rowcount
    conn.commit()
    conn.close()
    return (nrows > 0)

def clearDatasetRecord(dataset):
    """Removes a dataset from the job management database. To be used be care."""
    conn, c = getDbConn()
    sql = "DELETE FROM jobs WHERE dataset='%s'" % dataset
    nrows = conn.execute(sql).rowcount
    conn.commit()
    conn.close()
    return (nrows > 0)

def checkDataSetName(dataset):
    """Validates a dataset name"""
    a = dataset.split("/")
    if len(a) != 4:
        sys.stderr.write("Dataset name must contains three part /primary_dataset/conditions/tier")
        return False
    p = re.compile("MINIAOD(|SIM)")
    if not p.match(a[3]):
        sys.stderr.write("Only MINIAOD and MINIOADSIM data tiers are supported.")
        return False
    return True

def getCrabConfig(dataset, batch_id, runs, unitsPerJob, outDir, maxEvents):
    """Builds the crab configuration file."""
#    dataset_tier = dataset.split("/")[3]
#
#    if dataset_tier.find("SIM") > 0:
#        isMC = True
#    else:
#        isMC = False
    config = Configuration()

    config.section_('General')
#----------------------------------------------------------------------

#Request name. Used to identify job batch and to name the result directory    
    config.General.requestName = dataset.split('/')[1] + ("-%04d" % batch_id)

#Switch for the copy of the results to the storage site.
    config.General.transferOutputs = True

#Whether or not to copy the job log files to the storage site.
    config.General.transferLogs = True

    config.section_('JobType')
#----------------------------------------------------------------------

# CMSS Configuration file
    config.JobType.psetName = 'grow_baobabs_cfg.py'
#    config.JobType.psetName = 'pset.py'

# Output files that need to be collected, besides default CMSSW outputs
#    config.JobType.outputFiles = [ ]

    config.section_('Data')
#----------------------------------------------------------------------
# Name of the dataset to analyze
    config.Data.inputDataset = dataset

# Output directory on the storage site (storage site defined in the Site section)
    config.Data.outLFNDirBase = outDir

#Mode to use to split the task in jobs. 
# for 'Analysis' job type: 'FileBased', 'LumiBased' (recommended for real data), or 'EventAwareLumiBased'
# for 'PrivateMC' job type: 'EventBased'
    config.Data.splitting = 'EventAwareLumiBased'

# Runs to process (if runs list is empty, set to empty string, which indicates no run filter)
    config.Data.runRange = ",".join(map(str,runs))

# Number of units to produce or process
    if maxEvents and maxEvents > 0:
        config.Data.totalUnits = maxEvents

# Number of units (events in case of PrivateMC)  per job
    config.Data.unitsPerJob = unitsPerJob

# Switch for publication of output data to DBS
    config.Data.publication = False

    config.section_('User')
#----------------------------------------------------------------------
    
    config.section_('Site')
#----------------------------------------------------------------------

#A list of sites where the jobs should not run.
    config.Site.blacklist = ['T3_US_UMD', 'T3_TW_NTU_HEP', 'T3_GR_Demokritos', 'T3_GR_IASA', 'T2_GR_Ioannina', 'T3_MX_Cinvestav', 'T3_IT_Napoli', 'T2_DE_RWTH', 'T2_UK_SGrid_RALPP', 'T3_RU_FIAN', 'T2_FI_HIP']
    
#Site where the output should be copied. 
# See https://cmsweb.cern.ch/sitedb/prod/sites/ for the list of site names
    config.Site.storageSite = 'T2_CH_CERN'
    
    return config

def submitJobs(dataset, batch_id, runs, unitsPerJob, outDir, maxEvents):
    """Submits crab jobs to produce the Baobab ntuple from a provided dataset."""
    crab_config = getCrabConfig(dataset, batch_id, runs, unitsPerJob, outDir, maxEvents)

    f = open("crab_" + dataset.split("/")[1] + ("-%04d" % batch_id) + ".py", "w")
    f.write(str(crab_config))
    f.close()

    try:
        res = crabCommand('submit', config = crab_config)
        print "Task name:", res['uniquerequestname']
        try:
            props = { k: res[k] for k in ["uniquerequestname", "requestname"]}
            props["status"] = "submitted"
            props['ntuple_subdir'] = props['requestname'][5:] + "/" + props['requestname'] + "/" + props['uniquerequestname'].split(":")[0];
            updateDatasetRecord(dataset, batch_id, props)
        except KeyError:
            sys.stderr.write("Error while submitting job for dataset %s. No requestname was returned." % dataset)
            updateDatasetRecord(dataset, batch_id, { "status": "submission_error"})
    except HTTPException, e:
        updateDatasetRecord(dataset, batch_id, { "status": "submission_error"})
        print e.headers
    except ConfigException, e:
        updateDatasetRecord(dataset, batch_id, { "status": "submission_error"})
        print e

def check(dataset = None, batch_id = None):
    conn, c = getDbConn()
    sql = "SELECT dataset, batch_id, status, status_ts, requestname, ntuple_dir, ntuple_subdir FROM jobs WHERE status != 'finished order by dataset, batch_id ORDER BY dataset, batch_id'";
    if dataset:
        sql += " AND dataset='%s'" % dataset
    if batch_id:
        sql += " AND batch_id=%d" % batch_id
    c = tuple(conn.execute(sql))
    conn.close()
    for r in c:
        (dataset, batch_id, status, status_ts, requestname, ntuple_dir, ntuple_subdir) = r
        if status not in  ['REPORT_DONE', 'REPORT_DONE_WITH_FAILURES']:
            if status != 'CLOSED_WITH_FAILURES':
                res = crabCommand("status", "-d", requestname)
                new_status="REPORT_DONE"
                if res["status"] != status:
                    updateDatasetRecord(dataset, batch_id, {"status": res["status"], "status_ts": int(time.time())})
                    status = res["status"]
                else:
                    dt_hours = (time.time() - status_ts)/3600
                    if dt_hours > 10:
                        sys.stderr.write("Job batch %d of dataset %s is stuck in state %s for %d hour(s).\n" % 
                                         (batch_id, dataset, status, int(dt_hours+0.5)))
                    #endif dt_hours
                #endif res["status"]
            else:
                new_status="REPORT_DONE_WITH_FAILURES"
            #endif status
         
            if status in ["COMPLETED", "CLOSED_WITH_FAILURES"]:
                res = crabCommand("report", "-d", requestname)
                #print res
                lumiSummaryFile = requestname + "/results/lumiSummary.json"
                lumiSummaryFileEosCpy = " /eos/cms/" + ntuple_dir + "/" + ntuple_subdir + "/lumiSummary.json"
                try:
                    f = open(lumiSummaryFile)
                    md5sum = hashfile(f, hashlib.md5())
                    #copy lumi file to result directory on EOS
                    print "Save lumi summary into %s " %  (lumiSummaryFileEosCpy + "/" + lumiSummaryFile)
                    rc = os.system(eos_command + " cp -s " + lumiSummaryFile + " " +  lumiSummaryFileEosCpy)
                    if rc!=0:
                        sys.stderr.write("Failed to copy luminosity summary file into EOS for dataset '%s'"  % dataset)
                    else:
                        updateDatasetRecord(dataset, batch_id, {"status": new_status, "n_events": res["eventsRead"], "n_files": res["processedFiles"], "lumi_file_md5sum": md5sum})
                except IOError, e:
                    sys.stderr.write(e)
            #endif status

def forceClose(dataset, batch_id):
    if not isDatasetInDb(dataset, batch_id):
        sys.stderr.write("No job batch found for dataset %s. Please check the dataset name.\n" % dataset)
        return
    print "\nChecking the status of the jobs for dataset %s..." % dataset
    check(dataset, batch_id)
    status =  getDatasetStatus(dataset, batch_id)
    if not status:
        sys.stderr.write("Could not find the job status for dataset %s. Check dataset name.\n" % dataset)
    elif status in ['CLOSED_WITH_FAILURES', 'report_done']:
        sys.stderr.write("Job batch for dataset %s is already closed.\n")
    elif status != 'FAILED':
        sys.stderr.write("Job batch for dataset %s is in status %s. Only batch with status FAILED can be closed with this command.\n" % (dataset, status))
    else:
        if updateDatasetRecord(dataset, batch_id, {"status": "CLOSED_WITH_FAILURES"}):
            print "The job batch for dataset %s has closed." % dataset
        else:
            sys.stderr.write("Failed to close job batch for dataset %s\n" % dataset)
    print "\nObtaining the crab report..."
    #call check() again to produce the crab report
    check(dataset, batch_id)

