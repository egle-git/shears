def dasQuery(query):
    """Performs a query to the DAQ database"""
    host='https://cmsweb.cern.ch'
    idx=0
    limit=0
    debug=False
    if args.verbosity > 0:
        sys.stderr.write("DAS query: %s\n" % query)  
    das_res=das_client.get_data(host, query, idx, limit, debug)
    data=das_res['data']
    res=[]
    for r in data:
        val = das_client.prim_value(r)
        res.append(val)
    return res

def dasQuery2(query, att):
    """Performs a query to the DAQ database"""
    host='https://cmsweb.cern.ch'
    idx=0
    limit=0
    debug=False
    obj, item = att.split(".")
    if args.verbosity > 0:
        sys.stderr.write("DAS query: %s\n" % query)  
    das_res=das_client.get_data(host, query, idx, limit, debug)
    data = das_res['data']
    res = []
    for r in data:
        if obj in r:
            load = r[obj]
            for x in load:
                if item in x:
                    res.append(x[item])
                    break
    return res


def dasQueryPrint(query):
    """Makes a DAS database query and displays the result"""
    res = dasQuery(query)
    print "\n".join(res)

def dasRuns(dataset):
    """Retrieves from the DAS database the list of available runs for a given dataset."""
    return dasQuery('run dataset=' + dataset);

